{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build -w @kinotest/api",
    "watchPatterns": [
      "apps/api/**",
      "packages/shared/**",
      "package.json",
      "package-lock.json",
      "railway.json"
    ]
  },
  "deploy": {
    "preDeployCommand": ["npm run db:deploy -w @kinotest/api"],
    "startCommand": "npm run start -w @kinotest/api",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
