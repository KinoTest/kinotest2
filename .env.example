# Copy to .env (never commit .env)
DATABASE_URL=postgresql://kinotest:kinotest@localhost:5432/kinotest
PORT=3000
# Comma-separated origins allowed by the API (mobile, admin, site dev servers)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4321
# Used by the mobile and admin apps. VITE_* variables are read from THIS file (the repo root) and only
# when the dev server starts: restart it after changing them.
VITE_API_URL=http://localhost:3000
# Public URL of the image bucket, no trailing slash (local Garage; in Railway it is a build variable)
VITE_MEDIA_URL=http://kinotest-dev.web.garage.localhost:3902
# Min. 32 chars. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
APP_URL=http://localhost:5173
# This email becomes `owner` on its first login (optional)
OWNER_EMAIL=owner@example.com
# Max magic-link requests per IP every 15 min
LINK_RATE_LIMIT_PER_IP=20

# Mail: console (prints the link in the API terminal) | resend | memory (tests only)
MAIL_PROVIDER=console
# Only with MAIL_PROVIDER=resend
RESEND_API_KEY=
# Only with MAIL_PROVIDER=resend. The address must belong to a domain verified in Resend
MAIL_FROM=Kinotest <login@kinotest.me>

# Optional: test database (must end in _test). If empty, it is derived from DATABASE_URL
# TEST_DATABASE_URL=postgresql://kinotest:kinotest@localhost:5432/kinotest_test

# Image storage: IMAGE_STORE=s3 (Cloudflare R2; Garage locally) or memory (tests)
# The values below are for the local Garage service of docker-compose.yml (throwaway credentials).
# Run `node scripts/dev-storage.mjs` once to prepare its bucket (public read + CORS).
IMAGE_STORE=s3
R2_ENDPOINT=http://localhost:3900
R2_BUCKET=kinotest-dev
R2_ACCESS_KEY_ID=GK0123456789abcdef0123456789abcdef
R2_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef