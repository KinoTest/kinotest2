# Copy to .env (never commit .env)
DATABASE_URL=postgresql://kinotest:kinotest@localhost:5432/kinotest
PORT=3000
# Comma-separated origins allowed by the API (mobile, admin, site dev servers)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4321
# Used by the mobile and admin apps
VITE_API_URL=http://localhost:3000
JWT_SECRET=so_secret
APP_URL=http://localhost:5173
# This email becomes `owner` on its first login (optional)
OWNER_EMAIL=bytes4life@landras.eu
# Max magic-link requests per IP every 15 min
LINK_RATE_LIMIT_PER_IP=20

# Mail: console (prints the link in the API terminal) | resend | memory (tests only)
MAIL_PROVIDER=console
# Only with MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=Kinotest <login@kinotest.me>

# Optional: test database (must end in _test). If empty, it is derived from DATABASE_URL
# TEST_DATABASE_URL=postgresql://kinotest:kinotest@localhost:5432/kinotest_test