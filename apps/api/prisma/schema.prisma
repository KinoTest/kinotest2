generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Keep in sync with roleSchema in packages/shared/src/roles.ts
enum Role {
  owner
  user
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  role          Role           @default(user)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  contentItems  ContentItem[]
  refreshTokens RefreshToken[]
}

// Magic-link token (single use). Only the hash is stored. The user is created on verify.
model LoginToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// A content document (e.g. a remedy catalog). The whole JSON lives in `data`;
// slug/lang/title/formatVersion are copied from it so they can be listed without loading it.
model ContentItem {
  id            String   @id @default(uuid())
  slug          String
  lang          String
  title         String
  formatVersion Int      @default(1)
  data          Json
  authorId      String
  author        User     @relation(fields: [authorId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([slug, lang])
  @@index([authorId])
}
