generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Keep in sync with roleSchema in packages/shared/src/roles.ts
enum Role {
  owner
  user
}

model User {
  id              String              @id @default(uuid())
  email           String              @unique
  role            Role                @default(user)
  // Set when the user verifies a magic link. Null = account created by the owner (invited) and not confirmed yet.
  confirmedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  contentItems    ContentItem[]
  refreshTokens   RefreshToken[]
  assignments     TherapyAssignment[] @relation("AssignedTo")
  assignmentsMade TherapyAssignment[] @relation("AssignedBy")
}

// Magic-link token (single use). Only the hash is stored. The user is created on verify.
model LoginToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// A content document (e.g. a remedy catalog). The whole JSON lives in `data`;
// contentId/lang/title/formatVersion are copied from it so they can be listed without loading it.
model ContentItem {
  id            String   @id @default(uuid())
  contentId     String
  lang          String
  title         String
  formatVersion Int      @default(1)
  data          Json
  authorId      String
  author        User     @relation(fields: [authorId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignments   TherapyAssignment[]

  @@unique([contentId, lang])
  @@index([authorId])
}

// A therapy (one ContentItem row, i.e. one language) assigned to a therapist (User) by the owner.
// A therapy that still has assignments cannot be deleted (RESTRICT, and a 409 from the API).
model TherapyAssignment {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation("AssignedTo", fields: [userId], references: [id], onDelete: Cascade)
  contentItemId String
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Restrict)
  assignedById  String
  assignedBy    User        @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  expiresAt     DateTime?
  note          String?
  // Price charged to the therapist, informational, in EUR.
  amount        Decimal?    @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([userId, contentItemId])
  @@index([contentItemId])
  @@index([assignedById])
}
