    "@ionic/react-router": "^9.0.13",
    "@kinotest/shared": "^0.0.0",
    "@kinotest/ui": "^0.0.0",
    "ionicons": "^8.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.6",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.94.0",
